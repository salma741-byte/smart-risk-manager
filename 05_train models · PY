import pandas as pd
import numpy as np
import sqlite3
import joblib
import os
import warnings
warnings.filterwarnings('ignore')

from sklearn.preprocessing      import StandardScaler
from sklearn.calibration        import CalibratedClassifierCV
from sklearn.ensemble           import RandomForestClassifier
from sklearn.metrics            import (accuracy_score, classification_report,
                                         roc_auc_score, f1_score, confusion_matrix)
from sklearn.utils.class_weight import compute_class_weight
from sklearn.model_selection    import TimeSeriesSplit
import xgboost as xgb

try:
    import optuna
    optuna.logging.set_verbosity(optuna.logging.WARNING)
    OPTUNA_OK = True
    print("✓ Optuna disponible")
except ImportError:
    OPTUNA_OK = False
    print("⚠️  pip install optuna  pour l'optimisation automatique")

os.makedirs("models", exist_ok=True)
DB_PATH        = "data/market_data.db"
VIX_SEUIL      = 20.0
VOL_PERCENTILE = 60
N_TRIALS       = 50

CONFIANCE = {
    "STRESSE":        {'achat': 0.68, 'vente': 0.32},
    "CALME_TENDANCE": {'achat': 0.70, 'vente': 0.30},
    "CALME_LATERAL":  {'achat': 0.75, 'vente': 0.25},
}



def charger_dataset():
    conn = sqlite3.connect(DB_PATH)
    df   = pd.read_sql("SELECT * FROM sp500_ml_features",
                        conn, index_col='date', parse_dates=['date'])
    fc   = pd.read_sql("SELECT feature FROM features_calme",
                        conn)['feature'].tolist()
    fs   = pd.read_sql("SELECT feature FROM features_stresse",
                        conn)['feature'].tolist()
    conn.close()
    df.sort_index(inplace=True)
    return df, fc, fs

def detecter_regime_affine(df):
    vol_seuil  = df['vol_20d'].quantile(VOL_PERCENTILE / 100)
    cond_vix   = (df['vix_close'] > VIX_SEUIL).astype(int)
    cond_vol   = (df['vol_20d']   > vol_seuil).astype(int)
    cond_ma    = (df['close']     < df['ma_200']).astype(int)
    est_stress = ((cond_vix + cond_vol + cond_ma) >= 2)

    if 'adx_14' in df.columns:
        est_tendance = (~est_stress) & (df['adx_14'] > 20)
    else:
        ma_pente     = df['close'].rolling(20).mean().pct_change(5).abs()
        est_tendance = (~est_stress) & (ma_pente > ma_pente.quantile(0.40))

    regime = pd.Series(0, index=df.index)
    regime[est_tendance] = 1
    regime[est_stress]   = 2

    n_lat  = (regime == 0).sum()
    n_tend = (regime == 1).sum()
    n_str  = (regime == 2).sum()
    n_tot  = len(regime)
    print(f"  STRESSÉ        : {n_str}j ({n_str/n_tot*100:.1f}%)")
    print(f"  CALME_TENDANCE : {n_tend}j ({n_tend/n_tot*100:.1f}%)")
    print(f"  CALME_LATERAL  : {n_lat}j ({n_lat/n_tot*100:.1f}%)")
    return regime, vol_seuil

def preparer_X(df, feat_cols):
    cols = [c for c in feat_cols if c in df.columns]
    X    = df[cols].copy()
    X.replace([np.inf, -np.inf], np.nan, inplace=True)
    for col in X.columns:
        if X[col].isna().any():
            X[col].fillna(X[col].median(), inplace=True)
        q_low  = X[col].quantile(0.01)
        q_high = X[col].quantile(0.99)
        X[col] = X[col].clip(q_low, q_high)
    return X.values, cols

def trouver_seuil_optimal(y_true, probas):
    auc = roc_auc_score(y_true, probas)
    if auc < 0.50:
        probas = 1 - probas
        print("    ⚠️  Signal inversé → flip probas")
    meilleur_seuil, meilleur_f1 = 0.5, 0.0
    for seuil in np.arange(0.25, 0.76, 0.01):
        preds = (probas >= seuil).astype(int)
        if len(np.unique(preds)) < 2:
            continue
        f1 = f1_score(y_true, preds, average='macro')
        if f1 > meilleur_f1:
            meilleur_f1    = f1
            meilleur_seuil = seuil
    return meilleur_seuil, probas

def optimiser_xgb(X_train, y_train, n_trials=N_TRIALS):
    if not OPTUNA_OK:
        return None
    print(f"  Optuna : {n_trials} essais...")
    tscv = TimeSeriesSplit(n_splits=4)
    cw   = compute_class_weight('balanced', classes=np.array([0, 1]), y=y_train)
    sw   = np.where(y_train == 1, cw[1], cw[0])

    def objective(trial):
        p = {
            'n_estimators':     trial.suggest_int('n_estimators', 100, 600),
            'max_depth':        trial.suggest_int('max_depth', 2, 6),
            'learning_rate':    trial.suggest_float('lr', 0.005, 0.15, log=True),
            'subsample':        trial.suggest_float('sub', 0.5, 0.95),
            'colsample_bytree': trial.suggest_float('col', 0.5, 0.95),
            'min_child_weight': trial.suggest_int('mcw', 5, 50),
            'gamma':            trial.suggest_float('gam', 0.0, 0.5),
            'reg_alpha':        trial.suggest_float('alp', 0.0, 1.0),
            'reg_lambda':       trial.suggest_float('lam', 0.5, 3.0),
        }
        sp = max(0.5, (y_train == 0).sum() / max(1, (y_train == 1).sum()))
        scores = []
        for tr_i, va_i in tscv.split(X_train):
            if len(np.unique(y_train[va_i])) < 2:
                continue
            sc  = StandardScaler()
            Xtr = np.nan_to_num(sc.fit_transform(X_train[tr_i]))
            Xva = np.nan_to_num(sc.transform(X_train[va_i]))
            m   = xgb.XGBClassifier(**p, scale_pos_weight=sp,
                                     eval_metric='auc',
                                     use_label_encoder=False,
                                     random_state=42, n_jobs=-1, verbosity=0)
            m.fit(Xtr, y_train[tr_i], sample_weight=sw[tr_i], verbose=False)
            scores.append(roc_auc_score(y_train[va_i],
                                         m.predict_proba(Xva)[:, 1]))
        return np.mean(scores) if scores else 0.5

    study = optuna.create_study(direction='maximize',
                                 sampler=optuna.samplers.TPESampler(seed=42))
    study.optimize(objective, n_trials=n_trials, show_progress_bar=False)
    bp = study.best_params
    return {
        'n_estimators':     bp['n_estimators'],
        'max_depth':        bp['max_depth'],
        'learning_rate':    bp['lr'],
        'subsample':        bp['sub'],
        'colsample_bytree': bp['col'],
        'min_child_weight': bp['mcw'],
        'gamma':            bp['gam'],
        'reg_alpha':        bp['alp'],
        'reg_lambda':       bp['lam'],
    }

PARAMS_DEFAUT = {
    "STRESSE": dict(n_estimators=300, max_depth=3, learning_rate=0.02,
                    subsample=0.65, colsample_bytree=0.65,
                    min_child_weight=20, gamma=0.3,
                    reg_alpha=0.3, reg_lambda=2.0),
    "CALME_TENDANCE": dict(n_estimators=400, max_depth=4, learning_rate=0.03,
                            subsample=0.75, colsample_bytree=0.75,
                            min_child_weight=15, gamma=0.15,
                            reg_alpha=0.15, reg_lambda=1.5),
    "CALME_LATERAL": dict(n_estimators=100, max_depth=1, learning_rate=0.01,
                           subsample=0.60, colsample_bytree=0.60,
                           min_child_weight=45, gamma=0.4,
                           reg_alpha=0.5, reg_lambda=5.0),
}
def entrainer_modele(X_train, y_train, X_test, y_test, nom, feat_cols):
    print(f"\n  {'─'*50}")
    print(f"  Régime : {nom}")
    print(f"  Train : {len(X_train)}j  |  Test : {len(X_test)}j")
    print(f"  Balance : {y_train.mean():.2%} hausse")

    if len(X_train) < 50:
        print("  ⚠️  Pas assez de données")
        return None, None, None, 0.5

    scaler = StandardScaler()
    X_tr_s = np.nan_to_num(scaler.fit_transform(X_train))
    X_te_s = np.nan_to_num(scaler.transform(X_test))

    sp = max(0.5, (y_train == 0).sum() / max(1, (y_train == 1).sum()))
    cw = compute_class_weight('balanced', classes=np.array([0, 1]), y=y_train)
    sw = np.where(y_train == 1, cw[1], cw[0])

    best_p = optimiser_xgb(X_tr_s, y_train) or PARAMS_DEFAUT.get(
        nom, PARAMS_DEFAUT["CALME_TENDANCE"])

    # ───────── XGBoost ─────────
    xgb_base = xgb.XGBClassifier(
        **best_p,
        scale_pos_weight=sp,
        eval_metric='auc',
        use_label_encoder=False,
        random_state=42,
        n_jobs=-1
    )
    xgb_base.fit(X_tr_s, y_train, sample_weight=sw, verbose=False)

    # ✅ Calibration TIME SERIES SAFE
    tscv = TimeSeriesSplit(n_splits=3)
    xgb_m = CalibratedClassifierCV(xgb_base, method='isotonic', cv=tscv)
    xgb_m.fit(X_tr_s, y_train)

    # ───────── Random Forest ─────────
    rf_m = RandomForestClassifier(
        n_estimators=400,
        max_depth=best_p.get('max_depth', 3),
        min_samples_leaf=20,
        max_features='sqrt',
        class_weight='balanced',
        random_state=42,
        n_jobs=-1
    )
    rf_m.fit(X_tr_s, y_train)

    # ───────── Probabilités ─────────
    p_xgb = xgb_m.predict_proba(X_te_s)[:, 1]
    p_rf  = rf_m.predict_proba(X_te_s)[:, 1]

    auc_xgb = roc_auc_score(y_test, p_xgb)
    auc_rf  = roc_auc_score(y_test, p_rf)

    # ✅ sécurisation poids
    total_auc = auc_xgb + auc_rf
    if total_auc == 0:
        w_xgb, w_rf = 0.5, 0.5
    else:
        w_xgb = auc_xgb / total_auc
        w_rf  = auc_rf  / total_auc

    probas_ens = w_xgb * p_xgb + w_rf * p_rf
    auc_ens    = roc_auc_score(y_test, probas_ens)

    print(f"  AUC XGB={auc_xgb:.4f} | RF={auc_rf:.4f} | "
          f"Ensemble={auc_ens:.4f} (w_xgb={w_xgb:.2f})")

    seuil, probas_corr = trouver_seuil_optimal(y_test, probas_ens)
    preds = (probas_corr >= seuil).astype(int)
    acc   = accuracy_score(y_test, preds)

    print(f"  Seuil={seuil:.2f} | Accuracy={acc:.4f} | AUC={auc_ens:.4f}")
    print(classification_report(y_test, preds,
          target_names=['Baisse', 'Hausse'], zero_division=0))
    print("  Confusion :")
    print(confusion_matrix(y_test, preds))

    # ───────── Confiance ─────────
    conf_achat = CONFIANCE.get(nom, CONFIANCE["CALME_LATERAL"])['achat']
    conf_vente = CONFIANCE.get(nom, CONFIANCE["CALME_LATERAL"])['vente']

    masque = (probas_corr >= conf_achat) | (probas_corr <= conf_vente)
    if masque.sum() > 0:
        acc_conf = accuracy_score(y_test[masque], preds[masque])
        print(f"  Accuracy signaux confiants : {acc_conf:.4f} (n={masque.sum()})")

    # ───────── Feature importance ─────────
    if hasattr(xgb_base, "feature_importances_"):
        imp = pd.Series(xgb_base.feature_importances_, index=feat_cols)
        print("\n  Top 6 features :")
        for fname, fval in imp.nlargest(6).items():
            print(f"    {fname:<32} {fval:.4f}")

    ensemble = {
        'xgb': xgb_m,
        'rf': rf_m,
        'w_xgb': w_xgb,
        'w_rf': w_rf
    }

    return ensemble, scaler, probas_corr, seuil

def predire(ensemble, scaler, X_raw):
    X_s   = np.nan_to_num(scaler.transform(X_raw))
    p_xgb = ensemble['xgb'].predict_proba(X_s)[:, 1]
    p_rf  = ensemble['rf'].predict_proba(X_s)[:, 1]
    return ensemble['w_xgb'] * p_xgb + ensemble['w_rf'] * p_rf

def signal_du_jour(df, resultats, vol_seuil):
    print("\n" + "=" * 55)
    print("  SIGNAL DU JOUR")
    print("=" * 55)

    last     = df.iloc[-1]
    cond_vix = int(last.get('vix_close', 15) > VIX_SEUIL)
    cond_vol = int(last.get('vol_20d',  0.01) > vol_seuil)
    cond_ma  = int(last.get('close',     1)   < last.get('ma_200', 1))
    score    = cond_vix + cond_vol + cond_ma

    if score >= 2:
        regime = "STRESSE"
    elif last.get('adx_14', 0) > 20:
        regime = "CALME_TENDANCE"
    else:
        regime = "CALME_LATERAL"

    print(f"  Date   : {df.index[-1].strftime('%Y-%m-%d')}")
    print(f"  Régime : {regime}  (score stress {score}/3)")
    print(f"    VIX={last.get('vix_close', 0):.1f} | "
          f"Vol={last.get('vol_20d', 0):.4f} | "
          f"ADX={last.get('adx_14', 0):.1f} | "
          f"MA200={'⚠️ SOUS' if cond_ma else '✅ AU-DESSUS'}")

    if regime not in resultats:
        fallback = "CALME_TENDANCE" if "CALME_TENDANCE" in resultats \
                   else list(resultats.keys())[0]
        print(f"  → Fallback vers {fallback}")
        regime = fallback

    r     = resultats[regime]
    feats = r['feats']
    X     = np.array([[last.get(f, 0) for f in feats]])
    proba = predire(r['ensemble'], r['scaler'], X)[0]
    seuil = r['seuil']

    conf   = CONFIANCE.get(regime, CONFIANCE["CALME_LATERAL"])
    signal = "ACHAT"  if proba >= conf['achat'] else \
             "VENTE"  if proba <= conf['vente'] else "NEUTRE"
    emoji  = "🟢" if signal == "ACHAT" else ("🔴" if signal == "VENTE" else "🟡")
    dist   = abs(proba - 0.5)
    niveau = "HAUTE" if dist > 0.20 else "MOYENNE" if dist > 0.12 else "FAIBLE"

    print(f"\n  P(hausse 5j) = {proba*100:.1f}%  |  Seuil = {seuil:.2f}")
    print(f"  Confiance    = {niveau}")
    print(f"  ┌──────────────────────────────────┐")
    print(f"  │  SIGNAL → {emoji}  {signal:<10}           │")
    print(f"  │  Modèle : {regime:<25}│")
    print(f"  │  Confiance : {niveau:<22}│")
    print(f"  └──────────────────────────────────┘")

    if niveau == "FAIBLE":
        print(f"\n  ⚠️  Confiance faible → prudence recommandée")
        print(f"     Attends proba < {conf['vente']:.2f} ou > {conf['achat']:.2f}")

    return signal, proba, regime

if __name__ == "__main__":
    print("=" * 55)
    print("  MODULE 2 — 3 RÉGIMES + ZONES DE CONFIANCE")
    print("=" * 55)

    df, feats_calme, feats_stress = charger_dataset()
    print(f"Dataset : {len(df)}j × {df.shape[1]} colonnes")

    print("\nDétection des régimes...")
    regime, vol_seuil = detecter_regime_affine(df)
    df['regime'] = regime.values

    print("\n" + "=" * 55)
    print("  STATISTIQUES PAR RÉGIME")
    print("=" * 55)
    noms_reg = {0: "CALME_LATERAL", 1: "CALME_TENDANCE", 2: "STRESSE"}
    for code, nom in noms_reg.items():
        sub = df[df['regime'] == code]
        if len(sub) == 0:
            continue
        print(f"\n  {nom} ({len(sub)}j) :")
        print(f"    % hausse 5j : {sub['target'].mean()*100:.1f}%")
        print(f"    Vol moy     : {sub['vol_20d'].mean()*100:.2f}%")
        print(f"    VIX moy     : {sub['vix_close'].mean():.1f}")

    split    = int(len(df) * 0.80)
    df_train = df.iloc[:split]
    df_test  = df.iloc[split:]
    print(f"\nSplit : Train={len(df_train)}j | Test={len(df_test)}j")

    print("\n" + "=" * 55)
    print("  ENTRAÎNEMENT")
    print("=" * 55)

    configs = [
        ("STRESSE",        2, feats_stress),
        ("CALME_TENDANCE", 1, feats_calme),
        ("CALME_LATERAL",  0, feats_calme),
    ]

    resultats = {}
    for nom, code, feats in configs:
        train_r = df_train[df_train['regime'] == code]
        test_r  = df_test[df_test['regime']   == code]

        if len(train_r) < 50 or len(test_r) < 10:
            print(f"\n  ⚠️  {nom} : données insuffisantes "
                  f"(train={len(train_r)}, test={len(test_r)})")
            continue

        X_train, cols = preparer_X(train_r, feats)
        X_test,  _    = preparer_X(test_r,  feats)
        y_train = train_r['target'].values
        y_test  = test_r['target'].values

        ens, scaler, probas, seuil = entrainer_modele(
            X_train, y_train, X_test, y_test, nom, cols
        )

        if ens is not None:
            joblib.dump(ens,    f"models/ensemble_{nom.lower()}.pkl")
            joblib.dump(scaler, f"models/scaler_{nom.lower()}.pkl")
            joblib.dump(seuil,  f"models/seuil_{nom.lower()}.pkl")
            joblib.dump(cols,   f"models/feats_{nom.lower()}.pkl")
            resultats[nom] = {
                'ensemble': ens,
                'scaler':   scaler,
                'seuil':    seuil,
                'feats':    cols,
            }
            print(f"  → {nom} sauvegardé ✓")

    joblib.dump({
        'vix_seuil':      VIX_SEUIL,
        'vol_percentile': VOL_PERCENTILE,
        'vol_seuil':      vol_seuil,
        'confiance':      CONFIANCE,
    }, "models/regime_params.pkl")

    signal_du_jour(df, resultats, vol_seuil)
    print("\nModule 2 terminé ✓")