# 6. HISTORIQUE DES PRÉDICTIONS (suivi dans le temps)
# ─────────────────────────────────────────────────────────────

def sauvegarder_prediction(r):
    """
    Sauvegarde la prédiction du jour dans un CSV historique.
    Permet de suivre l'évolution des scores dans le temps.
    """
    path = "results/historique_tendances.csv"

    nouvelle_ligne = {
        'date'           : r['date'].date(),
        'close'          : r['close'],
        'vix'            : r['vix'],
        'regime'         : r['regime'],
        'score_global'   : r['score_global'],
        'score_ct'       : r['score_ct'],
        'score_mt'       : r['score_mt'],
        'score_lt'       : r['score_lt'],
        'score_ml'       : r['score_ml'],
        'proba_ml'       : round(r['proba_ml'], 4),
        'tendance_global': r['tendance_global'].strip(),
        'conviction'     : r['conviction'],
    }

    if os.path.exists(path):
        hist = pd.read_csv(path)
        # Éviter les doublons sur la même date
        hist = hist[hist['date'] != str(nouvelle_ligne['date'])]
        hist = pd.concat([hist, pd.DataFrame([nouvelle_ligne])],
                          ignore_index=True)
    else:
        hist = pd.DataFrame([nouvelle_ligne])

    hist.to_csv(path, index=False)
    print(f"\n  Prédiction sauvegardée → {path}")


# ─────────────────────────────────────────────────────────────
# 7. BACKTEST DES PRÉDICTIONS DE TENDANCE
# ─────────────────────────────────────────────────────────────

def backtest_tendance(df, sp, n_last=252):
    """
    Vérifie la qualité des prédictions de tendance
    sur les N derniers jours (défaut = 1 an).
    """
    print(f"\n  BACKTEST TENDANCE — {n_last} derniers jours")
    print(f"  {'─'*50}")

    resultats = []
    indices   = df.index[-n_last-5:-5]   # on garde 5j pour la vérification

    for date in indices[::5]:   # vérification toutes les 5 barres (hebdo)
        try:
            row     = df.loc[date]
            sp_hist = sp.loc[:date]
            vix_val = row.get('vix_close', 20)
            regime  = 'crash' if vix_val >= 30 else ('stress' if vix_val >= 20 else 'calme')

            # Score composite simplifié pour le backtest
            s_ct, _ = score_technique(row, sp_hist, 'court')
            s_mt, _ = score_technique(row, sp_hist, 'moyen')
            score   = s_ct * 0.4 + s_mt * 0.6

            # Vérification 5 jours après
            date_verif = df.index[df.index.get_loc(date) + 5] \
                         if df.index.get_loc(date) + 5 < len(df) else None

            if date_verif is None:
                continue

            ret_5j = df.loc[date_verif, 'close'] / df.loc[date, 'close'] - 1

            # Prédiction correcte si score et réalité dans le même sens
            pred_correct = (score > 0 and ret_5j > 0) or (score < 0 and ret_5j < 0)

            resultats.append({
                'date'        : date,
                'score'       : score,
                'ret_5j_reel' : ret_5j,
                'correct'     : pred_correct
            })
        except Exception:
            continue

    if not resultats:
        print("  Pas assez de données pour le backtest.")
        return

    res_df    = pd.DataFrame(resultats)
    precision = res_df['correct'].mean() * 100
    n_pred    = len(res_df)
    n_correct = res_df['correct'].sum()

    # Précision par niveau de conviction
    res_df['abs_score'] = res_df['score'].abs()
    res_df['conviction'] = pd.cut(res_df['abs_score'],
                                   bins=[0, 20, 40, 100],
                                   labels=['Faible', 'Modérée', 'Forte'])

    print(f"  Prédictions testées : {n_pred}")
    print(f"  Précision globale   : {precision:.1f}%")
