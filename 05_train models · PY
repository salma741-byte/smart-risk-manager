# ============================================================
#  4_prediction_tendance.py
#  Prédiction de tendance marché : HAUSSIÈRE / BAISSIÈRE
#
#  3 horizons :
#    Court terme  : 5 jours
#    Moyen terme  : 20 jours
#    Long terme   : 60 jours
#
#  Méthode : combinaison ML (modèles existants) +
#            analyse technique multi-timeframe +
#            score de conviction global
# ============================================================

import warnings
warnings.filterwarnings('ignore')

import numpy as np
import pandas as pd
import sqlite3
import joblib
import os
from datetime import datetime, timedelta

DB_PATH = "data/market_data.db"
os.makedirs("results", exist_ok=True)


# ─────────────────────────────────────────────────────────────
# 1. CHARGEMENT DES DONNÉES
# ─────────────────────────────────────────────────────────────

def charger_donnees():
    conn = sqlite3.connect(DB_PATH)
    df   = pd.read_sql("SELECT * FROM sp500_ml_features",
                        conn, index_col='date', parse_dates=['date'])

    # Prix bruts pour calculs techniques
    sp   = pd.read_sql("SELECT * FROM sp500_prices ORDER BY date",
                        conn, index_col='date', parse_dates=['date'])
    vix  = pd.read_sql("SELECT date, close as vix_close FROM vix_prices ORDER BY date",
                        conn, index_col='date', parse_dates=['date'])
    conn.close()

    df.sort_index(inplace=True)
    sp.sort_index(inplace=True)
    sp.columns = [c.lower() for c in sp.columns]

    # Enrichissement minimal
    if 'vix_close' in df.columns:
        df['delta_vix']           = df['vix_close'].diff(1)
        df['vix_pct_rank']        = df['vix_close'].rolling(252, min_periods=60).rank(pct=True)
        df['rolling_corr_sp_vix'] = df['ret_1d'].rolling(20).corr(df['vix_ret_1d'])
        df['vix_mean_reversion']  = (df['vix_close'] /
                                     df['vix_close'].rolling(252, min_periods=60).mean() - 1)

    df['zscore_price_60d'] = (
        (df['close'] - df['close'].rolling(60).mean()) /
        df['close'].rolling(60).std()
    )
    if 'drawdown_20d' not in df.columns:
        df['drawdown_20d'] = (df['close'] / df['close'].rolling(20).max() - 1) * 100
    if 'drawdown_50d' not in df.columns:
        df['drawdown_50d'] = (df['close'] / df['close'].rolling(50).max() - 1) * 100

    df.replace([np.inf, -np.inf], np.nan, inplace=True)
    df.ffill(inplace=True)

    return df, sp, vix


# ─────────────────────────────────────────────────────────────
# 2. SCORE DE TENDANCE TECHNIQUE (sans ML)
# ─────────────────────────────────────────────────────────────

def score_technique(df_row, df_hist, horizon='court'):
    """
    Calcule un score de tendance purement technique.
    Retourne un score entre -100 (très baissier) et +100 (très haussier).

    Court  terme (5j)  : momentum, RSI, MACD
    Moyen  terme (20j) : moyennes mobiles, Bollinger, tendance
    Long   terme (60j) : structure de marché, MA200, momentum long
    """
    close = df_hist['close']
    idx   = df_row.name

    # Données jusqu'à aujourd'hui uniquement (zero leakage)
    hist = df_hist.loc[:idx]
    if len(hist) < 200:
        return 0, {}

    score      = 0
    composants = {}

    if horizon == 'court':
        # ── RSI 14 ───────────────────────────────────────────────
        rsi = df_row.get('rsi_14', 50)
        if   rsi > 60: s_rsi = +20
        elif rsi > 50: s_rsi = +10
        elif rsi < 40: s_rsi = -20
        elif rsi < 50: s_rsi = -10
        else:          s_rsi = 0
        composants['RSI'] = s_rsi

        # ── MACD histogram ──────────────────────────────────────
        macd_h = df_row.get('macd_hist', 0)
        if   macd_h > 0 and df_row.get('macd_hist', 0) > 0: s_macd = +20
        elif macd_h > 0:                                      s_macd = +10
        elif macd_h < 0:                                      s_macd = -20
        else:                                                  s_macd = 0
        composants['MACD'] = s_macd

        # ── Momentum 5 jours ────────────────────────────────────
        ret5 = df_row.get('ret_5d', 0)
        if   ret5 > 0.02:  s_mom = +20
        elif ret5 > 0:     s_mom = +10
        elif ret5 < -0.02: s_mom = -20
        else:              s_mom = -10
        composants['Momentum 5j'] = s_mom

        # ── VIX ──────────────────────────────────────────────────
        vix = df_row.get('vix_close', 20)
        if   vix < 15:  s_vix = +20
        elif vix < 20:  s_vix = +10
        elif vix < 25:  s_vix = -10
        elif vix < 30:  s_vix = -20
        else:           s_vix = -40
        composants['VIX'] = s_vix

        # ── Stochastique ─────────────────────────────────────────
        stoch = df_row.get('stoch_k', 50) if 'stoch_k' in df_row.index else 50
        if   stoch > 70: s_stoch = +20
        elif stoch > 50: s_stoch = +10
        elif stoch < 30: s_stoch = -20
        else:            s_stoch = -10
        composants['Stochastique'] = s_stoch

        score = sum(composants.values())

    elif horizon == 'moyen':
        # ── Prix vs MA20 ─────────────────────────────────────────
        p_ma20 = df_row.get('prix_vs_ma20', 0)
        if   p_ma20 > 0.02:  s_ma20 = +20
        elif p_ma20 > 0:     s_ma20 = +10
        elif p_ma20 < -0.02: s_ma20 = -20
        else:                s_ma20 = -10
        composants['Prix/MA20'] = s_ma20

        # ── Prix vs MA50 ─────────────────────────────────────────
        p_ma50 = df_row.get('prix_vs_ma50', 0)
        if   p_ma50 > 0.03:  s_ma50 = +20
        elif p_ma50 > 0:     s_ma50 = +10
        elif p_ma50 < -0.03: s_ma50 = -20
        else:                s_ma50 = -10
        composants['Prix/MA50'] = s_ma50

        # ── Bollinger %B ─────────────────────────────────────────
        bb_z = df_row.get('bb_zscore', 0)
        if   bb_z > 1.5:  s_bb = +20
        elif bb_z > 0.5:  s_bb = +10
        elif bb_z < -1.5: s_bb = -20
        elif bb_z < -0.5: s_bb = -10
        else:             s_bb = 0
        composants['Bollinger'] = s_bb

        # ── MA20 vs MA50 (golden/death cross) ───────────────────
        ma_ratio = df_row.get('ratio_20_50', 1)
        if   ma_ratio > 1.02: s_cross = +20
        elif ma_ratio > 1.00: s_cross = +10
        elif ma_ratio < 0.98: s_cross = -20
        else:                 s_cross = -10
        composants['MA20/MA50'] = s_cross

        # ── Volatilité (vol basse = tendance stable) ─────────────
        vol_r = df_row.get('vol_ratio_5_20', 1) if 'vol_ratio_5_20' in df_row.index else 1
        if   vol_r < 0.8: s_vol = +20   # vol en contraction = tendance forte
        elif vol_r < 1.0: s_vol = +10
        elif vol_r > 1.5: s_vol = -20   # vol en expansion = danger
        else:             s_vol = -10
        composants['Volatilité'] = s_vol

        score = sum(composants.values())

    else:  # long terme
        # ── Prix vs MA200 ────────────────────────────────────────
        p_ma200 = df_row.get('prix_vs_ma200', 0)
        if   p_ma200 > 0.05:  s_ma200 = +30
        elif p_ma200 > 0:     s_ma200 = +15
        elif p_ma200 < -0.05: s_ma200 = -30
        else:                 s_ma200 = -15
        composants['Prix/MA200'] = s_ma200

        # ── MA50 vs MA200 (tendance longue) ──────────────────────
        ma_r_long = df_row.get('ratio_50_200', 1)
        if   ma_r_long > 1.03: s_long = +30
        elif ma_r_long > 1.00: s_long = +15
        elif ma_r_long < 0.97: s_long = -30
        else:                  s_long = -15
        composants['MA50/MA200'] = s_long

        # ── Momentum long terme (60j) ────────────────────────────
        mom60 = df_row.get('ret_20d', 0)  # approximation
        if   mom60 > 0.05:  s_m60 = +20
        elif mom60 > 0:     s_m60 = +10
        elif mom60 < -0.05: s_m60 = -20
        else:               s_m60 = -10
        composants['Momentum long'] = s_m60

        # ── Drawdown depuis le sommet ─────────────────────────────
        dd = df_row.get('drawdown_20d', 0)
        if   dd > -3:   s_dd = +20
        elif dd > -10:  s_dd = +10
        elif dd > -20:  s_dd = -20
        else:           s_dd = -30
        composants['Drawdown'] = s_dd

        score = sum(composants.values())

    # Normaliser entre -100 et +100
    n_composants = len(composants)
    max_possible = n_composants * 30
    score_norm   = max(-100, min(100, score / max_possible * 100))

    return round(score_norm, 1), composants


# ─────────────────────────────────────────────────────────────
# 3. SCORE ML (depuis les modèles entraînés)
# ─────────────────────────────────────────────────────────────

def score_ml(df, regime):
    """
    Retourne la probabilité de hausse du modèle ML pour
    le dernier jour disponible.
    """
    try:
        modeles  = joblib.load(f"models/ensemble_{regime}.pkl")
        scaler   = joblib.load(f"models/scaler_{regime}.pkl")
        features = joblib.load(f"models/features_{regime}.pkl")
    except FileNotFoundError:
        return 0.5, 0.5

    derniere    = df.iloc[[-1]]
    feats_dispo = [f for f in features if f in derniere.columns]
    X           = derniere[feats_dispo].values
    X_scaled    = scaler.transform(X)

    poids  = {'rf': 0.30, 'xgb': 0.50, 'lr': 0.20}
    proba  = 0.0
    for nom, m in modeles.items():
        p = m['model'].predict_proba(X_scaled)[0, 1]
        w = poids.get(nom, 0.33)
        proba += p * w

    return proba, proba * 2 - 1   # proba [0,1] et score [-1,+1]


# ─────────────────────────────────────────────────────────────
# 4. ANALYSE DE TENDANCE COMPLÈTE
# ─────────────────────────────────────────────────────────────

def analyser_tendance(df, sp):
    """
    Combine ML + technique sur 3 horizons.
    Retourne un rapport complet de tendance.
    """
    derniere   = df.iloc[-1]
    date_actuelle = df.index[-1]
    vix_actuel = derniere.get('vix_close', 20)
    regime     = ('crash'  if vix_actuel >= 30 else
                  'stress' if vix_actuel >= 20 else 'calme')
    close_actuel = derniere['close']

    # ── Scores techniques par horizon ───────────────────────────
    score_ct, comp_ct = score_technique(derniere, sp, 'court')
    score_mt, comp_mt = score_technique(derniere, sp, 'moyen')
    score_lt, comp_lt = score_technique(derniere, sp, 'long')

    # ── Score ML ────────────────────────────────────────────────
    proba_ml, score_ml_norm = score_ml(df, regime)

    # ── Score ML converti en -100/+100 ──────────────────────────
    score_ml_100 = round((proba_ml - 0.5) * 200, 1)

    # ── Score composite global ───────────────────────────────────
    # Pondération : CT=20%, MT=30%, LT=25%, ML=25%
    score_global = (
        score_ct    * 0.20 +
        score_mt    * 0.30 +
        score_lt    * 0.25 +
        score_ml_100* 0.25
    )

    # ── Label de tendance ────────────────────────────────────────
    def label_tendance(score, horizon=""):
        if   score >= 60:  return f"FORTEMENT HAUSSIÈRE  ▲▲"
        elif score >= 25:  return f"HAUSSIÈRE            ▲"
        elif score >= 5:   return f"LÉGÈREMENT HAUSSIÈRE △"
        elif score >= -5:  return f"NEUTRE               →"
        elif score >= -25: return f"LÉGÈREMENT BAISSIÈRE ▽"
        elif score >= -60: return f"BAISSIÈRE            ▼"
        else:              return f"FORTEMENT BAISSIÈRE  ▼▼"

    def conviction(score):
        abs_s = abs(score)
        if   abs_s >= 60: return "TRÈS FORTE"
        elif abs_s >= 35: return "FORTE"
        elif abs_s >= 15: return "MODÉRÉE"
        else:             return "FAIBLE"

    # ── Niveaux clés ─────────────────────────────────────────────
    ma20  = sp['close'].rolling(20).mean().iloc[-1]
    ma50  = sp['close'].rolling(50).mean().iloc[-1]
    ma200 = sp['close'].rolling(200).mean().iloc[-1]

    support_1  = round(ma50 * 0.97, 2)
    support_2  = round(ma200 * 0.98, 2)
    resistance = round(sp['close'].rolling(20).max().iloc[-1] * 1.02, 2)

    return {
        'date'          : date_actuelle,
        'close'         : close_actuel,
        'vix'           : vix_actuel,
        'regime'        : regime,

        # Scores
        'score_ct'      : score_ct,
        'score_mt'      : score_mt,
        'score_lt'      : score_lt,
        'score_ml'      : score_ml_100,
        'score_global'  : round(score_global, 1),
        'proba_ml'      : proba_ml,

        # Labels
        'tendance_ct'   : label_tendance(score_ct),
        'tendance_mt'   : label_tendance(score_mt),
        'tendance_lt'   : label_tendance(score_lt),
        'tendance_global': label_tendance(score_global),
        'conviction'    : conviction(score_global),

        # Composants détaillés
        'composants_ct' : comp_ct,
        'composants_mt' : comp_mt,
        'composants_lt' : comp_lt,

        # Niveaux
        'ma20'          : round(ma20, 2),
        'ma50'          : round(ma50, 2),
        'ma200'         : round(ma200, 2),
        'support_1'     : support_1,
        'support_2'     : support_2,
        'resistance'    : resistance,
    }


