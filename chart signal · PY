# ─────────────────────────────────────────────────────────────
# 1. CHARGEMENT DONNÉES + MODÈLES
# ─────────────────────────────────────────────────────────────

def charger_tout():
    conn = sqlite3.connect(DB_PATH)
    df   = pd.read_sql("SELECT * FROM sp500_ml_features",
                        conn, index_col='date', parse_dates=['date'])
    conn.close()
    df.sort_index(inplace=True)

    # Enrichissement (même que 2_train_models_FINAL)
    if 'vix_close' in df.columns:
        df['delta_vix']           = df['vix_close'].diff(1)
        df['vix_pct_rank']        = df['vix_close'].rolling(252, min_periods=60).rank(pct=True)
        df['rolling_corr_sp_vix'] = df['ret_1d'].rolling(20).corr(df['vix_ret_1d'])
        df['vix_mean_reversion']  = (df['vix_close'] /
                                     df['vix_close'].rolling(252, min_periods=60).mean() - 1)

    df['zscore_price_60d'] = (
        (df['close'] - df['close'].rolling(60).mean()) /
        df['close'].rolling(60).std()
    )
    if 'drawdown_20d' not in df.columns:
        df['drawdown_20d'] = (df['close'] / df['close'].rolling(20).max() - 1) * 100
    if 'drawdown_50d' not in df.columns:
        df['drawdown_50d'] = (df['close'] / df['close'].rolling(50).max() - 1) * 100

    df['regime_bin'] = np.where(df['vix_close'] < 20, 'calme', 'stress') \
                       if 'vix_close' in df.columns else 'calme'

    df['return_5j'] = df['close'].pct_change(5).shift(-5)
    df['target']    = np.nan
    df.loc[df['return_5j'] >  0.015, 'target'] = 1
    df.loc[df['return_5j'] < -0.008, 'target'] = 0

    df.replace([np.inf, -np.inf], np.nan, inplace=True)
    df.ffill(inplace=True)
    df.dropna(subset=['target'], inplace=True)
    df.dropna(inplace=True)

    # Charger les modèles
    modeles, scalers, features = {}, {}, {}
    for regime in ['calme', 'stress']:
        try:
            modeles[regime]  = joblib.load(f"models/ensemble_{regime}.pkl")
            scalers[regime]  = joblib.load(f"models/scaler_{regime}.pkl")
            features[regime] = joblib.load(f"models/features_{regime}.pkl")
            print(f"  ✓ Modèle {regime} chargé")
        except FileNotFoundError:
            print(f"  ⚠ Modèle {regime} absent — lance 2_train_models_FINAL.py")

    return df, modeles, scalers, features


# ─────────────────────────────────────────────────────────────
# 2. CALCUL DES VALEURS SHAP (XGBoost — le plus interprétable)
# ─────────────────────────────────────────────────────────────

def calculer_shap(df, modeles, scalers, features, regime, n_sample=500):
    """
    Calcule les valeurs SHAP sur un échantillon du test set.
    Utilise le modèle XGBoost (modèle 'xgb' de l'ensemble).
    """
    print(f"\n  Calcul SHAP — régime {regime.upper()}...")

    mask  = df['regime_bin'] == regime
    df_r  = df[mask].copy()

    if len(df_r) < 50:
        print(f"  ⚠ Pas assez de données ({len(df_r)}) pour {regime}")
        return None, None, None

    # Features disponibles
    feats = [f for f in features[regime] if f in df_r.columns]

    # Split temporel — prendre le test set (20% final)
    split = int(len(df_r) * 0.80)
    X_test = df_r[feats].iloc[split:]
    y_test = df_r['target'].iloc[split:]

    # Sous-échantillon pour la vitesse
    if len(X_test) > n_sample:
        idx    = np.random.choice(len(X_test), n_sample, replace=False)
        idx    = sorted(idx)
        X_samp = X_test.iloc[idx]
        y_samp = y_test.iloc[idx]
    else:
        X_samp = X_test
        y_samp = y_test

    # Scaler
    scaler   = scalers[regime]
    X_scaled = scaler.transform(X_samp)
    X_df     = pd.DataFrame(X_scaled, columns=feats, index=X_samp.index)
    X_np     = X_scaled.astype(np.float64)   # XGBoost>=2.0 + SHAP exigent numpy pur

    # Extraire le XGBoost depuis l'ensemble calibré
    xgb_model = None
    for nom, m in modeles[regime].items():
        if nom == 'xgb':
            # CalibratedClassifierCV → accéder au modèle sous-jacent
            try:
                # sklearn >= 1.0
                base = m['model'].calibrated_classifiers_[0].estimator
            except AttributeError:
                try:
                    base = m['model'].calibrated_classifiers_[0].base_estimator
                except AttributeError:
                    base = m['model']
            xgb_model = base
            break

    if xgb_model is None:
        print(f"  ⚠ XGBoost non trouvé dans l'ensemble {regime}")
        return None, None, None

    # Explainer SHAP — numpy obligatoire pour XGBoost >= 2.0
    explainer  = shap.TreeExplainer(xgb_model)
    shap_vals  = explainer.shap_values(X_np)   # ← X_np pas X_df

    # Si multi-output → prendre classe 1 (hausse)
    if isinstance(shap_vals, list):
        shap_vals = shap_vals[1]

    print(f"    SHAP calculé sur {len(X_df)} observations, {len(feats)} features")

    return shap_vals, X_df, feats


# ─────────────────────────────────────────────────────────────
# 3. GRAPHE 1 — BEESWARM SUMMARY PLOT
# ─────────────────────────────────────────────────────────────

def graphe_beeswarm(shap_vals, X_df, feats, regime, top_n=20):
    """
    Beeswarm plot — montre la distribution des valeurs SHAP
    pour chaque feature. Couleur = valeur de la feature.
    """
    n_feat    = min(top_n, len(feats))
    mean_abs  = np.abs(shap_vals).mean(axis=0)
    top_idx   = np.argsort(mean_abs)[::-1][:n_feat]
    top_feats = [feats[i] for i in top_idx]
    top_shap  = shap_vals[:, top_idx]
    top_X     = X_df.iloc[:, top_idx]

    fig, ax = plt.subplots(figsize=(14, 10))
    fig.patch.set_facecolor(BG)
    ax.set_facecolor(BG2)

    titre_fig(fig,
              f"SHAP — IMPORTANCE DES FEATURES ({regime.upper()})",
              f"Beeswarm plot — chaque point = 1 observation | "
              f"couleur = valeur de la feature | axe X = impact sur P(hausse)")

    # Colormap : bleu (valeur basse) → rouge (valeur haute)
    cmap = LinearSegmentedColormap.from_list('br', [BLUE, CYAN, ORANGE, RED])

    # Tracer chaque feature
    for i, (feat_idx, feat_name) in enumerate(zip(range(n_feat), top_feats)):
        shap_col  = top_shap[:, feat_idx]
        feat_col  = top_X.iloc[:, feat_idx]

        # Normaliser la couleur
        feat_norm = (feat_col - feat_col.min()) / (feat_col.max() - feat_col.min() + 1e-9)

        # Jitter vertical pour le beeswarm
        y_jitter = np.random.uniform(-0.3, 0.3, len(shap_col))
        y_pos    = (n_feat - 1 - i) + y_jitter

        colors = cmap(feat_norm.values)
        ax.scatter(shap_col, y_pos, c=colors, s=8, alpha=0.6,
                   linewidths=0, zorder=3)

        # Ligne de référence
        ax.axhline(n_feat - 1 - i, color=GRID, linewidth=0.4,
                   alpha=0.5, zorder=1)

        # Importance moyenne (barre grise)
        imp = mean_abs[top_idx[feat_idx]]
        ax.barh(n_feat - 1 - i, imp * 0.3, left=-imp * 0.3 - 0.5,
                height=0.3, color=TEXT2, alpha=0.15, zorder=2)

    ax.set_yticks(range(n_feat))
    ax.set_yticklabels([nom_lisible(f) for f in reversed(top_feats)],
                        fontsize=8.5)
    ax.set_xlabel("Valeur SHAP  (→ augmente P(hausse)  ←  diminue P(hausse))",
                  color=TEXT2)
    ax.axvline(0, color=GRID, linewidth=1, alpha=0.8)
    ax.set_xlim(top_shap.min() * 1.1, top_shap.max() * 1.1)

    # Colorbar
    sm = plt.cm.ScalarMappable(cmap=cmap,
                                norm=plt.Normalize(vmin=0, vmax=1))
    sm.set_array([])
    cbar = fig.colorbar(sm, ax=ax, shrink=0.4, pad=0.01)
    cbar.set_label("Valeur normalisée de la feature\n(bas → haut)",
                   color=TEXT2, fontsize=8)
    cbar.ax.yaxis.set_tick_params(color=TEXT2)

    # Annotation
    color_regime = GREEN if regime == 'calme' else ORANGE
    ax.text(0.98, 0.02,
            f"Régime : {regime.upper()}\n"
            f"N obs  : {len(X_df)}\n"
            f"N feat : {len(feats)}",
            transform=ax.transAxes, fontsize=8,
            va='bottom', ha='right', color=color_regime,
            fontfamily='monospace',
            bbox=dict(boxstyle='round,pad=0.5', facecolor=BG3,
                      edgecolor=color_regime, alpha=0.8))

    fig.tight_layout(rect=[0, 0, 1, 0.93])
    sauvegarder(fig, f"01_shap_beeswarm_{regime}")


# ─────────────────────────────────────────────────────────────
# 4. GRAPHE 2 — BAR PLOT COMPARAISON CALME vs STRESS
# ─────────────────────────────────────────────────────────────

def graphe_bar_comparaison(resultats_shap, top_n=25):
    """
    Barres horizontales comparant l'importance SHAP
    entre le régime calme et le régime stress.
    """
    # Récupérer toutes les features de chaque régime
    imp_calme  = {}
    imp_stress = {}

    for regime, (shap_vals, X_df, feats) in resultats_shap.items():
        if shap_vals is None:
            continue
        mean_abs = np.abs(shap_vals).mean(axis=0)
        for feat, imp in zip(feats, mean_abs):
            if regime == 'calme':
                imp_calme[feat] = imp
            else:
                imp_stress[feat] = imp

    # Union de toutes les features
    all_feats = list(set(list(imp_calme.keys()) + list(imp_stress.keys())))
    df_imp    = pd.DataFrame({
        'calme' : [imp_calme.get(f, 0)  for f in all_feats],
        'stress': [imp_stress.get(f, 0) for f in all_feats],
    }, index=all_feats)

    df_imp['total'] = df_imp['calme'] + df_imp['stress']
    df_imp          = df_imp.nlargest(top_n, 'total')
    df_imp          = df_imp.sort_values('total', ascending=True)

    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(18, 12))
    fig.patch.set_facecolor(BG)
    titre_fig(fig,
              "SHAP — IMPORTANCE COMPARÉE PAR RÉGIME",
              "Importance moyenne |SHAP| — calme vs stress — "
              "révèle quelles features comptent selon le contexte")

    noms = [nom_lisible(f) for f in df_imp.index]

    # ── Graphe gauche : côte à côte ───────────────────────────────
    y_pos = np.arange(len(df_imp))
    h     = 0.38

    ax1.barh(y_pos + h/2, df_imp['calme'].values,
             height=h, color=GREEN, alpha=0.8,
             label='Régime CALME', edgecolor='none')
    ax1.barh(y_pos - h/2, df_imp['stress'].values,
             height=h, color=ORANGE, alpha=0.8,
             label='Régime STRESS', edgecolor='none')

    ax1.set_yticks(y_pos)
    ax1.set_yticklabels(noms, fontsize=8)
    ax1.set_xlabel("|SHAP| moyen")
    ax1.set_title("Importance par régime")
    ax1.legend(fontsize=9, loc='lower right')
    ax1.axvline(0, color=GRID, linewidth=0.6)

    # ── Graphe droit : différentiel stress - calme ────────────────
    diff = df_imp['stress'] - df_imp['calme']
    colors_diff = [ORANGE if d > 0 else GREEN for d in diff.values]

    ax2.barh(y_pos, diff.values, color=colors_diff, alpha=0.8,
             edgecolor='none')
    ax2.axvline(0, color=TEXT2, linewidth=1.2)

    ax2.set_yticks(y_pos)
    ax2.set_yticklabels(noms, fontsize=8)
    ax2.set_xlabel("Différentiel SHAP  (stress − calme)")
    ax2.set_title("Features exclusives à chaque régime\n"
                  "Orange = plus important en stress  |  "
                  "Vert = plus important en calme")

    # Annotations
    for i, (d, f) in enumerate(zip(diff.values, df_imp.index)):
        if abs(d) > diff.abs().quantile(0.75):
            label = "↑ STRESS" if d > 0 else "↑ CALME"
            col   = ORANGE if d > 0 else GREEN
            ax2.text(d + (0.001 if d > 0 else -0.001), i,
                     label, va='center',
                     ha='left' if d > 0 else 'right',
                     fontsize=7, color=col)

    for ax in [ax1, ax2]:
        ax.set_facecolor(BG2)
        ax.tick_params(colors=TEXT2)

    fig.tight_layout(rect=[0, 0, 1, 0.93])
    sauvegarder(fig, "02_shap_bar_comparaison")


# ─────────────────────────────────────────────────────────────
# 5. GRAPHE 3 — DEPENDENCE PLOTS (effets partiels top 6)
# ─────────────────────────────────────────────────────────────

def graphe_dependence(shap_vals, X_df, feats, regime, top_n=6):
    """
    Pour chaque top feature : scatter SHAP vs valeur de la feature.
    Montre comment la feature influence la prédiction.
    """
    mean_abs = np.abs(shap_vals).mean(axis=0)
    top_idx  = np.argsort(mean_abs)[::-1][:top_n]

    fig, axes = plt.subplots(2, 3, figsize=(18, 11))
    fig.patch.set_facecolor(BG)
    titre_fig(fig,
              f"SHAP — EFFETS PARTIELS TOP {top_n} FEATURES ({regime.upper()})",
              "Comment chaque feature influence P(hausse) — "
              "couleur = valeur de la feature d'interaction principale")
    axes = axes.flatten()

    # Feature d'interaction (VIX si dispo, sinon 2e feature)
    vix_col = 'vix_close' if 'vix_close' in feats else feats[1] if len(feats) > 1 else None

    for plot_i, feat_idx in enumerate(top_idx):
        ax        = axes[plot_i]
        feat_name = feats[feat_idx]
        shap_col  = shap_vals[:, feat_idx]
        feat_col  = X_df.iloc[:, feat_idx]

        # Couleur interaction
        if vix_col and vix_col in feats and feat_name != vix_col:
            vix_idx   = feats.index(vix_col)
            int_col   = X_df.iloc[:, vix_idx]
            int_label = nom_lisible(vix_col)
        else:
            int_col   = feat_col
            int_label = nom_lisible(feat_name)

        int_norm = (int_col - int_col.min()) / (int_col.max() - int_col.min() + 1e-9)

        cmap   = LinearSegmentedColormap.from_list('br', [BLUE, CYAN, RED])
        colors = cmap(int_norm.values)

        sc = ax.scatter(feat_col, shap_col, c=colors, s=12,
                        alpha=0.5, linewidths=0)

        # Ligne de tendance LOWESS
        try:
            from scipy.stats import binned_statistic
            bins   = min(30, len(feat_col) // 10)
            bin_means, bin_edges, _ = binned_statistic(
                feat_col, shap_col, statistic='mean', bins=bins)
            bin_centers = (bin_edges[:-1] + bin_edges[1:]) / 2
            valid = ~np.isnan(bin_means)
            ax.plot(bin_centers[valid], bin_means[valid],
                    color=YELLOW, linewidth=2, alpha=0.9,
                    label='Tendance moyenne', zorder=5)
        except Exception:
            pass

        ax.axhline(0, color=GRID, linewidth=0.8, alpha=0.7)
        ax.axvline(feat_col.mean(), color=TEXT2, linewidth=0.8,
                   linestyle=':', alpha=0.5, label='Moyenne')

        ax.set_xlabel(nom_lisible(feat_name), fontsize=8.5)
        ax.set_ylabel("Valeur SHAP", fontsize=8)
        ax.set_title(f"#{plot_i+1}  {nom_lisible(feat_name)}")

        # Colorbar par subplot
        sm    = plt.cm.ScalarMappable(cmap=cmap,
                                       norm=plt.Normalize(0, 1))
        sm.set_array([])
        cbar  = fig.colorbar(sm, ax=ax, shrink=0.6, pad=0.01)
        cbar.set_label(f"↑ {int_label}", fontsize=7, color=TEXT2)

        ax.legend(fontsize=7, loc='upper right')

    fig.tight_layout(rect=[0, 0, 1, 0.93])
    sauvegarder(fig, f"03_shap_dependence_{regime}")


# ─────────────────────────────────────────────────────────────
# 6. GRAPHE 4 — WATERFALL : EXPLICATION DU SIGNAL AUJOURD'HUI
# ─────────────────────────────────────────────────────────────

def graphe_waterfall_today(df, modeles, scalers, features):
    """
    Explique le signal du dernier jour disponible :
    montre comment chaque feature contribue à P(hausse).
    """
    vix_actuel = df['vix_close'].iloc[-1] if 'vix_close' in df.columns else 20
    regime     = 'calme' if vix_actuel < 20 else 'stress'

    if regime not in modeles:
        print(f"  ⚠ Modèle {regime} non disponible")
        return

    feats       = [f for f in features[regime] if f in df.columns]
    derniere    = df[feats].iloc[[-1]]
    X_scaled    = scalers[regime].transform(derniere)
    X_df        = pd.DataFrame(X_scaled, columns=feats)
    X_np        = X_scaled.astype(np.float64)   # numpy pur pour SHAP

    # XGBoost
    xgb_model = None
    for nom, m in modeles[regime].items():
        if nom == 'xgb':
            try:
                xgb_model = m['model'].calibrated_classifiers_[0].estimator
            except AttributeError:
                try:
                    xgb_model = m['model'].calibrated_classifiers_[0].base_estimator
                except AttributeError:
                    xgb_model = m['model']
            break

    if xgb_model is None:
        return

    explainer  = shap.TreeExplainer(xgb_model)
    shap_vals  = explainer.shap_values(X_np)   # ← numpy pur
    if isinstance(shap_vals, list):
        shap_vals = shap_vals[1]

    shap_today = shap_vals[0]
    base_val   = explainer.expected_value
    if isinstance(base_val, (list, np.ndarray)):
        base_val = base_val[1] if len(base_val) > 1 else base_val[0]

    # Top 15 contributions
    top_n   = 15
    idx_s   = np.argsort(np.abs(shap_today))[::-1][:top_n]
    s_top   = shap_today[idx_s]
    f_top   = [feats[i] for i in idx_s]
    v_top   = X_df.values[0][idx_s]

    # Valeurs originales (avant scaling)
    v_orig  = derniere.values[0][[list(feats).index(f) for f in f_top]]

    # Construire le waterfall
    cumul   = base_val
    steps   = [(base_val, 'Base', 0, None)]
    for feat, sh, v_o in zip(f_top, s_top, v_orig):
        steps.append((cumul, feat, sh, v_o))
        cumul += sh
    steps.append((cumul, 'PRÉDICTION', 0, None))

    final_proba = 1 / (1 + np.exp(-cumul))   # sigmoïde approximative

    fig, ax = plt.subplots(figsize=(14, 10))
    fig.patch.set_facecolor(BG)
    ax.set_facecolor(BG2)

    date_str = str(df.index[-1].date())
    titre_fig(fig,
              f"SHAP WATERFALL — EXPLICATION SIGNAL DU {date_str}",
              f"Régime : {regime.upper()}  |  VIX : {vix_actuel:.1f}  |  "
              f"P(hausse) finale : {final_proba*100:.1f}%")

    # Barres waterfall
    n     = len(steps)
    y_pos = range(n)
    lefts = []
    vals  = []
    cols  = []

    for i, (start, feat, sh, v_o) in enumerate(steps):
        if i == 0:  # Base
            lefts.append(0)
            vals.append(start)
            cols.append(BLUE)
        elif i == n - 1:  # Final
            lefts.append(0)
            vals.append(start)
            cols.append(GREEN if start > base_val else RED)
        else:
            lefts.append(min(start, start + sh))
            vals.append(abs(sh))
            cols.append(GREEN if sh > 0 else RED)

    ax.barh(y_pos, vals, left=lefts, color=cols,
            alpha=0.85, edgecolor=BG, linewidth=0.5, height=0.65)

    # Labels
    noms_labels = ['VALEUR DE BASE']
    for feat, sh, v_o in zip(f_top, s_top, v_orig):
        noms_labels.append(f"{nom_lisible(feat)}  [{v_o:.3f}]")
    noms_labels.append('PRÉDICTION FINALE')

    ax.set_yticks(list(y_pos))
    ax.set_yticklabels(noms_labels, fontsize=8.5)

    # Valeurs SHAP sur les barres
    for i, (start, feat, sh, _) in enumerate(steps):
        if i == 0:
            ax.text(start/2, i, f"{start:.3f}",
                    ha='center', va='center', fontsize=7.5,
                    color='white', fontweight='bold')
        elif i < n - 1:
            x_txt = start + sh/2
            ax.text(x_txt, i,
                    f"{sh:+.3f}", ha='center', va='center',
                    fontsize=7.5, color='white', fontweight='bold')
        else:
            ax.text(start/2, i, f"{start:.3f}  →  {final_proba*100:.1f}%",
                    ha='center', va='center', fontsize=8,
                    color='white', fontweight='bold')

    # Ligne de base
    ax.axvline(base_val, color=BLUE, linewidth=1,
               linestyle='--', alpha=0.5, label=f'Base = {base_val:.3f}')
    ax.axvline(0, color=GRID, linewidth=0.8, alpha=0.6)

    ax.set_xlabel("Score log-odds (→ hausse probable  |  ← baisse probable)")
    ax.legend(fontsize=8)

    # Box de résumé
    signal = "FORT ACHAT ▲▲" if final_proba > 0.65 else \
             "ACHAT ▲"       if final_proba > 0.55 else \
             "NEUTRE →"      if final_proba > 0.45 else \
             "VENTE ▼"
    color_signal = GREEN if final_proba > 0.55 else \
                   RED   if final_proba < 0.45 else TEXT2

    ax.text(0.98, 0.02,
            f"Signal : {signal}\nP(hausse) : {final_proba*100:.1f}%",
            transform=ax.transAxes, fontsize=10,
            va='bottom', ha='right', color=color_signal,
            fontweight='bold', fontfamily='monospace',
            bbox=dict(boxstyle='round,pad=0.6', facecolor=BG3,
                      edgecolor=color_signal, alpha=0.9))

    fig.tight_layout(rect=[0, 0, 1, 0.93])
    sauvegarder(fig, "04_shap_waterfall_today")


# ─────────────────────────────────────────────────────────────
# 7. GRAPHE 5 — HEATMAP SHAP DANS LE TEMPS
# ─────────────────────────────────────────────────────────────

def graphe_shap_time(shap_vals, X_df, feats, regime, top_n=12):
    """
    Heatmap de l'évolution des valeurs SHAP dans le temps.
    Permet de voir quand chaque feature a été determinante.
    """
    mean_abs = np.abs(shap_vals).mean(axis=0)
    top_idx  = np.argsort(mean_abs)[::-1][:top_n]
    top_feats = [feats[i] for i in top_idx]
    top_shap  = shap_vals[:, top_idx]

    # Normaliser chaque feature entre -1 et +1 pour la visualisation
    top_shap_norm = top_shap / (np.abs(top_shap).max(axis=0) + 1e-9)

    # Rééchantillonner sur 100 points si trop de données
    if len(X_df) > 200:
        step = len(X_df) // 100
        top_shap_norm = top_shap_norm[::step]
        dates = X_df.index[::step]
    else:
        dates = X_df.index

    fig, ax = plt.subplots(figsize=(18, 8))
    fig.patch.set_facecolor(BG)
    ax.set_facecolor(BG2)

    titre_fig(fig,
              f"SHAP DANS LE TEMPS — RÉGIME {regime.upper()}",
              "Contribution de chaque feature dans le temps — "
              "rouge = pousse vers hausse | bleu = pousse vers baisse")

    cmap = LinearSegmentedColormap.from_list('rb', [BLUE, BG2, RED])

    im = ax.imshow(top_shap_norm.T, cmap=cmap, vmin=-1, vmax=1,
                   aspect='auto', interpolation='nearest')

    ax.set_yticks(range(top_n))
    ax.set_yticklabels([nom_lisible(f) for f in top_feats], fontsize=9)

    # Axe x : dates
    n_ticks = min(10, len(dates))
    tick_idx = np.linspace(0, len(dates)-1, n_ticks, dtype=int)
    ax.set_xticks(tick_idx)
    ax.set_xticklabels([str(dates[i].date()) if hasattr(dates[i], 'date')
                        else str(dates[i])
                        for i in tick_idx],
                       rotation=30, ha='right', fontsize=7.5)

    plt.colorbar(im, ax=ax, shrink=0.6, pad=0.01,
                 label='SHAP normalisé (rouge=↑hausse, bleu=↑baisse)')

    ax.set_xlabel("Temps →")
    ax.set_title(f"Évolution des contributions SHAP — {regime.upper()}")

    fig.tight_layout(rect=[0, 0, 1, 0.93])
    sauvegarder(fig, f"05_shap_heatmap_time_{regime}")


